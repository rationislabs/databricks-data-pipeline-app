{
  "datasets": [
    {
      "name": "ds_mix",
      "displayName": "Daily generation mix",
      "queryLines": [
        "SELECT country, local_date, series, mwh\n",
        "FROM mix_daily"
      ]
    },
    {
      "name": "ds_share_month",
      "displayName": "Monthly renewable share",
      "queryLines": [
        "SELECT country, date_trunc('MONTH', local_date) AS month, avg(renewable_share) AS renewable_share\n",
        "FROM price_vs_renewables\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "ds_price_daily",
      "displayName": "Daily price per zone",
      "queryLines": [
        "SELECT zone, local_date, avg(eur_mwh) AS eur_mwh\n",
        "FROM price_vs_renewables\n",
        "WHERE eur_mwh IS NOT NULL\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "ds_scatter",
      "displayName": "Hourly price vs renewable share, last 90 days",
      "queryLines": [
        "SELECT country, renewable_share, eur_mwh\n",
        "FROM price_vs_renewables\n",
        "WHERE eur_mwh IS NOT NULL AND local_date >= date_sub(current_date(), 90)"
      ]
    },
    {
      "name": "ds_compare",
      "displayName": "Yearly renewable share",
      "queryLines": [
        "SELECT country, year(local_date) AS year, avg(renewable_share) AS renewable_share\n",
        "FROM price_vs_renewables\n",
        "GROUP BY ALL"
      ]
    }
  ],
  "pages": [
    {
      "name": "mix",
      "displayName": "Mix",
      "layout": [
        {
          "widget": {
            "name": "f_mix",
            "queries": [
              {
                "name": "f_mix_ds_mix",
                "query": {
                  "datasetName": "ds_mix",
                  "fields": [
                    {
                      "name": "country",
                      "expression": "`country`"
                    }
                  ],
                  "disaggregated": false
                }
              },
              {
                "name": "f_mix_ds_share_month",
                "query": {
                  "datasetName": "ds_share_month",
                  "fields": [
                    {
                      "name": "country",
                      "expression": "`country`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "country",
                    "displayName": "Country",
                    "queryName": "f_mix_ds_mix"
                  },
                  {
                    "fieldName": "country",
                    "displayName": "Country",
                    "queryName": "f_mix_ds_share_month"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Country"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 2,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "w_mix",
