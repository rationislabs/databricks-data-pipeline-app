                      "name": "local_date",
                      "expression": "`local_date`"
                    },
                    {
                      "name": "sum(mwh)",
                      "expression": "SUM(`mwh`)"
                    },
                    {
                      "name": "series",
                      "expression": "`series`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "area",
              "encodings": {
                "x": {
                  "fieldName": "local_date",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Day"
                },
                "y": {
                  "fieldName": "sum(mwh)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "MWh"
                },
                "color": {
                  "fieldName": "series",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Source"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Generation by source"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "w_share",
            "queries": [
              {
                "name": "main_query",
